{
  "name": "greenbin",
  "version": "1.0.0",
  "description": "GreenBin - Smart Waste Management & Sustainability Platform",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:all": "npm --prefix client run build",
    "start": "node server/src/server.js",
    "seed": "npm --prefix server run seed",
    "docker:up": "docker compose up -d mongodb",
    "docker:all": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "smart-waste-management",
    "sustainability",
    "iot-simulation",
    "react",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Dev-TA",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
