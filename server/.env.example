# ==========================================
# GreenBin Server Environment Configuration
# ==========================================

# Port the backend server listens on (cloud platforms set this automatically)
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Connection String (Local, Docker, or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/greenbin
# Atlas: mongodb+srv://<username>:<password>@cluster0.vocsww2.mongodb.net/greenbin?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/greenbin

# Central depot coordinates for route optimization (Latitude & Longitude)
DEPOT_LAT=26.8467
DEPOT_LNG=80.9462

# Allowed Client / Frontend URLs for CORS and WebSocket connections
# In production, set this to your hosted frontend URL (comma-separated if multiple, e.g., https://greenbin.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK Configuration (OPTIONAL for local development)
# Leave empty to run with built-in hybrid local authentication
FIREBASE_PROJECT_ID=greenbin-mock
# FIREBASE_SERVICE_ACCOUNT_KEY can be either:
# 1. Path to JSON file: ./config/firebase-service-account.json
# 2. Minified JSON string: {"type":"service_account",...}
# 3. Base64-encoded JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=
