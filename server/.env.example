# ==========================================
# GreenBin Server Environment Configuration
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String:
# Option 1 (Local MongoDB / Docker Compose):
MONGODB_URI=mongodb://127.0.0.1:27017/greenbin
# Option 2 (MongoDB Atlas Cloud Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/greenbin?retryWrites=true&w=majority

# Central Depot Location (Lucknow municipal center coordinates)
DEPOT_LAT=26.8467
DEPOT_LNG=80.9462

# Allowed Client URL for CORS
CLIENT_URL=http://localhost:5173

# Firebase Admin Configuration (OPTIONAL for local development)
# Leave blank to use built-in mock/local authentication mode
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
